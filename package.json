{
  "name": "dsh-plugin-tg-bridge",
  "description": "DSH <-> Telegram bridge as a profile plugin: forward session activity, replies, and question/approval button flows to Telegram, with a persistent GUI card in 插件配置.",
  "version": "0.1.1",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./client": "./lib/client.js",
    "./bridge": "./lib/bridge.js",
    "./markdown": "./lib/markdown.js",
    "./telegram": "./lib/telegram.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "lib",
    "README.md",
    "cordis.patch.yml"
  ],
  "license": "MIT",
  "scripts": {
    "build": "esbuild lib/index.js --bundle --format=esm --platform=node --target=node18 --outfile=dist/index.js --sourcemap",
    "prepack": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "esbuild": "^0.24.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "immediately": true
    }
  }
}